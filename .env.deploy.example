# Credentials from the Hostfactory control panel / your FileZilla site entry.
# .env.deploy is git-ignored — never commit it.

# Hostfactory's FTP server presents a certificate for *.hostfactory.ch, not for
# mogicato.ch, so connecting as "mogicato.ch" fails TLS verification. Both names
# point at the same machine (server11 = 185.117.169.60/.62).
FTP_HOST=server11.hostfactory.ch
FTP_USER=your-ftp-user
FTP_PASSWORD=your-ftp-password

# The web root, as FileZilla shows it under "Remote site".
FTP_REMOTE_DIR=/httpdocs

# true      require FTPS and verify the certificate (correct, and what works
#           with FTP_HOST=server11.hostfactory.ch)
# insecure  encrypt but skip verification — the equivalent of clicking
#           "trust this certificate" in FileZilla. Use only if the hostname
#           above ever stops matching.
# false     plain FTP. Sends the password in clear text. Avoid.
FTP_TLS=true
