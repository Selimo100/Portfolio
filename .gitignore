# macOS
.DS_Store

# Node
node_modules/
npm-debug.log*

# Python
__pycache__/
*.py[cod]
*.pyo

# VSCode
.vscode/

# intelliJ IDEA
.idea/

# Logs
*.log

# Environment files
.env
.env.*
# ...but the deploy template must ship, or nobody knows what to fill in.
!.env.deploy.example

# Build output
dist/
build/
out/
# Momo assistant secrets and runtime storage
server/config/openai.php
server/storage/ratelimit/
server/storage/rate-limit-salt
server/config/spotify.php
server/storage/spotify-top-tracks.json

# Next.js
.next/
next-env.d.ts

# TypeScript incremental build info
*.tsbuildinfo

# Local mail capture (npm run php)
server/storage/maillog
# Stray sendmail artefact if dev-mail.sh is bypassed
server/-f*

# FTP deploy manifest (.env.deploy is covered by the .env.* rule above)
.deploy-manifest.json

# Files pulled off the server before pruning them
.server-backup/
